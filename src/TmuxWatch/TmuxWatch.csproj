<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console" Version="0.57.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TmuxWatch.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shipped pointer-signal cursor asset(s), copied next to the app. -->
    <None Include="..\..\assets\**\*.cur" Link="assets\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
